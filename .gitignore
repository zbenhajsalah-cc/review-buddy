node_modules/
dist/
*.log
.DS_Store
storybook-static
*storybook.log

# TS incremental build info
*.tsbuildinfo

# Prebuilt viewer artifact — committed so `/plugin install` (a git clone) needs
# no `bun run build` step (plan 016). Re-included despite the generic `dist/`
# rule above. Rebuilt by CI + scripts/release.sh; grammar chunks are
# content-hashed and stable, so a UI-source change only rewrites the small core
# chunk, not the ~300 syntax grammars. Treated as generated in .gitattributes.
!/apps/plugin/ui/dist/
!/apps/plugin/ui/dist/**

# Prebuilt plugin bundles (dist/server.js, dist/hook.js) — committed for the
# same reason: an installed plugin runs them directly, with no node_modules and
# no build (US-04). Rebuilt by `pnpm build:plugin`; checked by verify:dist-fresh.
!/apps/plugin/dist/
!/apps/plugin/dist/**
