{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // The plugin resolves @review-buddy/core through these paths, not through
    // a workspace dependency: GitHub installs have no node_modules (Bun
    // auto-installs) and local clones run plain `bun install`, and neither
    // understands `workspace:*`. Bun honors tsconfig paths at runtime. Keep in
    // sync with "exports" in packages/core/package.json.
    "paths": {
      "@review-buddy/core/review.schema.json": ["./packages/core/schemas/review.schema.json"],
      "@review-buddy/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "src/ui", "dist"]
}
