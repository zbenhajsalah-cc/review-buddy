{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // The plugin source resolves @review-buddy/core through these paths, not a
    // `workspace:*` dependency. Installed plugins run the bundles in dist/
    // (core inlined), but older Cursor / Copilot / Codex configs still run
    // src/mcp/server.ts from clones set up with plain `bun install`, which
    // never links workspace packages. Bun honors tsconfig paths at runtime.
    // Keep in sync with "exports" in packages/core/package.json.
    "paths": {
      "@review-buddy/core/review.schema.json": ["./packages/core/schemas/review.schema.json"],
      "@review-buddy/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "src/ui", "dist"]
}
