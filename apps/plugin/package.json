{
  "name": "review-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted narrative code review for Claude Code — Prologue + risk-rated Chapters over a real git diff.",
  "type": "module",
  "bin": {
    "review-buddy": "bin/review-buddy.js"
  },
  "scripts": {
    "mcp": "bun run src/mcp/server.ts",
    "hook": "bun run src/cli/index.ts",
    "test": "bun test ./src",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build-plugin.ts",
    "smoke": "bun run scripts/smoke-plugin.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@review-buddy/core": "workspace:*",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.5",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  }
}
