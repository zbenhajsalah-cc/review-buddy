{
  "name": "@review-buddy/desktop",
  "private": true,
  "version": "0.4.0",
  "description": "Review Buddy desktop app (Electron): GitHub PRs reviewed with the same narrative viewer as the plugin.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "agent-check": "electron-vite dev -- --agent-check",
    "package": "electron-vite build && electron-builder --dir",
    "test": "bun test ./src",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "smoke": "electron-vite build && node scripts/smoke-desktop.ts"
  },
  "devDependencies": {
    "@review-buddy/core": "workspace:*",
    "@review-buddy/viewer": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.5",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296"
  }
}
